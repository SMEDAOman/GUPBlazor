@* Equivalent of <gup-track direction="horizontal|vertical" gap="N" horizontal-alignment="..." vertical-alignment="..." items-equal is-multiline>
   Gap is in multiples of --unit (4px), so gap=7 → 28px.
*@
<div class="gup-track @(ItemsEqual ? "gup-track--items-equal" : "") @(IsMultiline ? "gup-track--multiline" : "")" style="@Style">
    @ChildContent
</div>

@code {
    [Parameter] public int Gap { get; set; } = 2;
    [Parameter] public string Direction { get; set; } = "horizontal";
    [Parameter] public string HorizontalAlignment { get; set; } = "normal";
    [Parameter] public string VerticalAlignment { get; set; } = "normal";

    /// <summary>All items in a row have the same width (equivalent of flex: 1 on children).</summary>
    [Parameter] public bool ItemsEqual { get; set; }

    /// <summary>Allow items to wrap onto multiple lines (equivalent of flex-wrap).</summary>
    [Parameter] public bool IsMultiline { get; set; }

    [Parameter] public RenderFragment? ChildContent { get; set; }

    private string FlexDirection => Direction switch
    {
        "vertical"                  => "column",
        "vertical-on-mobile"        => "column",
        "vertical-reverse-on-mobile"=> "column-reverse",
        _                           => "row",
    };

    private string JustifyContent => HorizontalAlignment switch
    {
        "right"   => "flex-end",
        "left"    => "flex-start",
        "center"  => "center",
        "justify" => "space-between",
        _         => "normal",
    };

    private string AlignItems => VerticalAlignment switch
    {
        "top"    => "flex-start",
        "center" => "center",
        "bottom" => "flex-end",
        _        => "normal",
    };

    private string Style =>
        $"flex-direction:{FlexDirection}; gap:calc({Gap} * var(--unit)); justify-content:{JustifyContent}; align-items:{AlignItems};"
        + (IsMultiline ? " flex-wrap:wrap;" : "");
}
