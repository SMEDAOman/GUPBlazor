@* Renders a Material Symbols Outlined icon via the Google variable font. *@
<span class="gup-icon material-symbols-outlined"
      style="font-size:@(Width)px; @AxisStyle()"
      aria-hidden="true">@Normalize(IconName)</span>

@code {
    [Parameter] public string IconName { get; set; } = "";
    [Parameter] public int Width { get; set; } = 16;
    [Parameter] public int Height { get; set; } = 16;
    [Parameter] public bool Filled { get; set; } = false;
    [Parameter] public int Weight { get; set; } = 400;
    [Parameter] public int Grade { get; set; } = 0;

    private static string Normalize(string name) =>
        string.IsNullOrEmpty(name) ? "" : name.Replace('-', '_');

    private string AxisStyle() =>
        $"font-variation-settings: 'FILL' {(Filled ? 1 : 0)}, 'wght' {Weight}, 'GRAD' {Grade}, 'opsz' {Width};";
}
