@* Gov.om logo — inline SVG from design-system source.
   Equivalent of <gup-logo appearance="icon|horizontal|vertical" inverted="disabled|enabled|custom" title="..." href="..." size="24">
*@
@if (!string.IsNullOrEmpty(Href))
{
    <a class="gup-logo gup-logo--@Appearance gup-logo--inverted-@Inverted" href="@Href" title="@Title">
        @LogoMark
    </a>
}
else
{
    <div class="gup-logo gup-logo--@Appearance gup-logo--inverted-@Inverted" title="@Title">
        @LogoMark
    </div>
}

@code {
    /// <summary>Logo lockup: <c>icon</c> (default), <c>horizontal</c>, or <c>vertical</c>.</summary>
    [Parameter] public string Appearance { get; set; } = "icon";

    /// <summary>Accessible description of the logo, also shown as a tooltip on hover.</summary>
    [Parameter] public string Title { get; set; } = "Logo";

    /// <summary>Invert the logo colors for dark backgrounds: <c>disabled</c> (default), <c>enabled</c>, or <c>custom</c>.</summary>
    [Parameter] public string Inverted { get; set; } = "disabled";

    /// <summary>Optional link for the logo. When set, the logo is wrapped in an anchor.</summary>
    [Parameter] public string? Href { get; set; }

    /// <summary>Height of the logo in px; width scales proportionally. Default: 24.</summary>
    [Parameter] public int Size { get; set; } = 24;

    private bool IsHorizontal => string.Equals(Appearance, "horizontal", StringComparison.OrdinalIgnoreCase);

    private RenderFragment LogoMark => __builder =>
