@* Equivalent of <gup-spinner size="s|m|l|xl"> — accessible loading indicator.
   Renders the gov.om brand spinner SVG with a continuous rotation animation.
   Sizes: s=16px, m=24px (default), l=40px, xl=56px. Pass Pixels to override.
   Legacy small/medium/large values are still accepted for backward compatibility.
   Set LabelHidden to keep the label for screen-readers only.
*@
<span class="gup-spinner-wrapper @SizeClass" role="status">
    <svg class="gup-spinner"
         xmlns="http://www.w3.org/2000/svg"
         viewBox="0 0 40 40"
         fill="none"
         width="@RenderedSize"
         height="@RenderedSize"
         aria-hidden="true">
        <mask id="@MaskId" style="mask-type:alpha" maskUnits="userSpaceOnUse" x="0" y="0" width="40" height="40">
            <path d="M40 20C40 31.0457 31.0457 40 20 40C8.9543 40 -5.4282e-06 31.0457 -3.49691e-06 20C-1.56562e-06 8.9543 8.9543 1.56562e-06 20 3.49691e-06C31.0457 5.4282e-06 40 8.95431 40 20ZM6 20C6 27.732 12.268 34 20 34C27.732 34 34 27.732 34 20C34 12.268 27.732 6 20 6C12.268 6 6 12.268 6 20Z" />
        </mask>
        <g mask="url(#@MaskId)">
            <circle class="gup-spinner-circle" cx="20" cy="20" r="20" />
            <path class="gup-spinner-indicator" d="M40 20C40 25.3043 37.8929 30.3914 34.1421 34.1421C30.3914 37.8929 25.3043 40 20 40L20 20L40 20Z" />
        </g>
    </svg>
    @if (!string.IsNullOrEmpty(Text) && !LabelHidden)
    {
        <span class="gup-spinner-text">@Text</span>
    }
    <span class="gup-spinner-sr">@Label</span>
</span>

@code {
    /// <summary>Spinner size: <c>s</c>, <c>m</c> (default), <c>l</c>, or <c>xl</c>.
    /// Legacy <c>small</c>/<c>medium</c>/<c>large</c> values are also accepted.</summary>
    [Parameter] public string Size { get; set; } = "m";

    /// <summary>Override the size with an explicit pixel value.</summary>
    [Parameter] public int? Pixels { get; set; }

    /// <summary>Optional label displayed below the spinner (and read by screen-readers). Default: "Loading...".</summary>
    [Parameter] public string Label { get; set; } = "Loading...";

    /// <summary>Optional visible text alongside the spinner. Suppressed when <see cref="LabelHidden"/> is true.</summary>
    [Parameter] public string? Text { get; set; }

    /// <summary>If true, the label/text is hidden visually and available only to screen-readers (matches <c>label-hidden</c>).</summary>
    [Parameter] public bool LabelHidden { get; set; }

    private readonly string MaskId = $"gup-spinner-mask-{Guid.NewGuid():N}";

    // Normalizes both the new (s/m/l/xl) and legacy (small/medium/large) size values.
    private string SizeKey => Size?.ToLowerInvariant() switch
    {
        "s" or "small"  => "s",
        "l" or "large"  => "l",
        "xl"            => "xl",
        _               => "m",
    };

    private string SizeClass => $"gup-spinner--{SizeKey}";

    private int RenderedSize => Pixels ?? SizeKey switch
    {
        "s"  => 16,
        "l"  => 40,
        "xl" => 56,
        _    => 24,
    };
}
