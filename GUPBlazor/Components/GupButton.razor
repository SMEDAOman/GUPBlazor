@* Equivalent of <gup-button appearance="primary|secondary|text|danger" kind="button|link" ...>
   Named slots: IconStart, IconEnd
   Default slot: ChildContent (button label)
*@
@using Microsoft.AspNetCore.Components.Web

<div class="gup-button gup-button--@Appearance.ToString().ToLowerInvariant() @(Inverted ? "gup-button--inverted" : "") @(WithIconOnly ? "gup-button--icon-only" : "") @(Disabled ? "is-disabled" : "") @(SoftDisabled && !Disabled ? "gup-button--soft-disabled" : "")">
    @if (Kind == GupButtonKind.Link)
    {
        <a class="button"
           href="@(Disabled ? null : Href)"
           target="@(OpenInNewTab ? "_blank" : null)"
           rel="@(OpenInNewTab ? "noopener noreferrer" : null)"
           aria-disabled="@(Disabled ? "true" : null)"
           aria-label="@(WithIconOnly ? Label : null)"
           tabindex="@(Disabled ? "-1" : null)"
           @onclick="HandleClick"
           @onclick:preventDefault="Disabled">
            @if (IconStart != null)
            {
                <span class="btn-icon-start">@IconStart</span>
            }
            @if (!WithIconOnly)
            {
                @ChildContent
            }
            @if (IconEnd != null)
            {
                <span class="btn-icon-end">@IconEnd</span>
            }
        </a>
    }
    else
    {
        <button class="button"
                type="@Type.ToString().ToLowerInvariant()"
                disabled="@(Disabled ? true : null)"
                aria-label="@(WithIconOnly ? Label : null)"
                @onclick="HandleClick">
            @if (IconStart != null)
            {
                <span class="btn-icon-start">@IconStart</span>
            }
            @if (!WithIconOnly)
            {
                @ChildContent
            }
            @if (IconEnd != null)
            {
                <span class="btn-icon-end">@IconEnd</span>
            }
        </button>
    }
</div>

@code {
    [Parameter] public GupButtonAppearance Appearance { get; set; } = GupButtonAppearance.Primary;
    [Parameter] public GupButtonKind Kind { get; set; } = GupButtonKind.Button;
    [Parameter] public GupButtonType Type { get; set; } = GupButtonType.Button;
    [Parameter] public string? Href { get; set; }
    [Parameter] public bool Disabled { get; set; }

    /// <summary>
    /// Renders the button with the disabled *appearance* (greyed) while keeping it
    /// fully interactive — the click still fires. Use for "looks disabled until the
    /// form is valid, but pressing it reveals what's missing" affordances.
    /// Ignored when <see cref="Disabled"/> is true (a real disable wins).
    /// </summary>
    [Parameter] public bool SoftDisabled { get; set; }

    /// <summary>Display only the icon with no text label (matches <c>with-icon-only</c>).
    /// Provide <see cref="Label"/> for the accessible name.</summary>
    [Parameter] public bool WithIconOnly { get; set; }

    /// <summary>Whether the button is inverted (for dark backgrounds).</summary>
    [Parameter] public bool Inverted { get; set; }

    /// <summary>Accessible label used when <see cref="WithIconOnly"/> is true.</summary>
    [Parameter] public string Label { get; set; } = "";

    /// <summary>Open the URL in a new tab. Only applicable when <see cref="Kind"/> is Link.</summary>
    [Parameter] public bool OpenInNewTab { get; set; }

    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public RenderFragment? IconStart { get; set; }
    [Parameter] public RenderFragment? IconEnd { get; set; }
    [Parameter] public EventCallback<MouseEventArgs> OnClick { get; set; }

    private Task HandleClick(MouseEventArgs args)
    {
        if (Disabled)
        {
            return Task.CompletedTask;
        }
        return OnClick.InvokeAsync(args);
    }
}
