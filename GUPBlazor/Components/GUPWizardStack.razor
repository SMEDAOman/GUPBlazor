@* High-level wizard layout: wires GupHeader, GupContentHeader, GupWizardMain (with stepper)
   and GupWizardFooter. Steps are declared as <GUPWizardStackStep> children and shown one at a
   time based on CurrentStepIndex. *@

<CascadingValue Value="this" IsFixed="true">
    <div class="gup-wizard-stack" dir="@GetDirection()">

        @if (ShowHeader)
        {
            <GupHeader NavAriaLabel="@NavAriaLabel">
                <Start>@HeaderStart</Start>
                <End>@HeaderEnd</End>
            </GupHeader>
        }

        @if (ShowContentHeader && (!string.IsNullOrEmpty(PageTitle) || !string.IsNullOrEmpty(PageSubtitle) || PageSummary != null))
        {
            <GupContentHeader PageTitle="@PageTitle" PageSubtitle="@PageSubtitle">
                <PageSummary>@PageSummary</PageSummary>
            </GupContentHeader>
        }

        <GupWizardMain>

            @if (ShowStepper && _steps.Count > 0)
            {
                <GupDetails Open="@StepperOpen" ContentAppearance="@StepperAppearance"
                            ClosedIcon="@StepperClosedIcon" OpenIcon="@StepperOpenIcon">
                    <LabelContent>@CurrentStepperLabel</LabelContent>
                    <ChildContent>
                        <GupStepper StaticMode="true">
                            @for (var i = 0; i < _steps.Count; i++)
                            {
                                var idx = i;
                                var step = _steps[idx];
                                <GupStepperItem StepNumber="@((idx + 1).ToString())"
                                                StepType="@GetStepType(idx)">
                                    <LabelContent>@(step.StepLabel ?? step.Title)</LabelContent>
                                </GupStepperItem>
                            }
                        </GupStepper>
                    </ChildContent>
                </GupDetails>
            }

            @if (CurrentStep is { } current)
            {
                @if (!current.HideDefaultTitle && !string.IsNullOrEmpty(current.Title))
                {
                    <h2 class="gup-text-headline-md" style="margin-top: var(--gup-spacing-between-text); color: var(--gup-color-content-primary);">
                        @current.Title
                    </h2>
                }
                @if (!string.IsNullOrEmpty(current.Description))
                {
                    <p class="gup-text-body-xl" style="margin-top: 8px; color: var(--gup-color-content-primary);">
                        @current.Description
                    </p>
                }
            }

            @* Renders all <GUPWizardStackStep> components so they register with this stack.
               Each step renders its own ChildContent only when active. *@
            @ChildContent

        </GupWizardMain>

        @if (ShowFooter)
        {
            <GupWizardFooter>
                <Start>
                    @if (!IsFirstStep)
                    {
                        <GupButton Appearance="@GupButtonAppearance.Secondary"
                                   Kind="@GupButtonKind.Button"
                                   Type="@GupButtonType.Button"
                                   Disabled="@IsLoading"
                                   OnClick="HandleBackAsync"
                                   IconStart="@BackIconFragment">
                            <ChildContent>@CurrentBackButtonText</ChildContent>
                        </GupButton>
                    }
                </Start>
                <End>
                    <GupButton Appearance="@GupButtonAppearance.Primary"
                               Kind="@GupButtonKind.Button"
                               Type="@GupButtonType.Button"
                               Disabled="@(IsLoading || CurrentStep?.Locked == true)"
                               SoftDisabled="@(CurrentStep?.SoftLockNext == true)"
                               OnClick="HandleContinueAsync"
                               IconEnd="@ForwardIconFragment">
                        <ChildContent>@CurrentNextButtonText</ChildContent>
                    </GupButton>
                </End>
            </GupWizardFooter>
        }

    </div>
</CascadingValue>

@code {
    private readonly List<GUPWizardStackStep> _steps = new();

    [Parameter] public RenderFragment? ChildContent { get; set; }

    // Header
    [Parameter] public bool ShowHeader { get; set; } = true;
    [Parameter] public string NavAriaLabel { get; set; } = "Wizard Navigation Header";
    [Parameter] public RenderFragment? HeaderStart { get; set; }
    [Parameter] public RenderFragment? HeaderEnd { get; set; }

    // Content header
    [Parameter] public bool ShowContentHeader { get; set; } = true;
    [Parameter] public string PageTitle { get; set; } = "";
    [Parameter] public string? PageSubtitle { get; set; }
    [Parameter] public RenderFragment? PageSummary { get; set; }

    // Stepper
    [Parameter] public bool ShowStepper { get; set; } = true;
    [Parameter] public bool StepperOpen { get; set; } = true;

    /// <summary>
    /// Format string for the "Step N of M" progress label shown on the collapsible stepper header.
    /// <c>{0}</c> is the current step number (1-based), <c>{1}</c> is the total number of steps.
    /// Pass a translated template (e.g. an Arabic "الخطوة {0} من {1}") to localize it.
    /// </summary>
    [Parameter] public string StepLabelFormat { get; set; } = "Step {0} of {1}";
    [Parameter] public GupDetailsContentAppearance StepperAppearance { get; set; } = GupDetailsContentAppearance.Sink;
    [Parameter] public string StepperClosedIcon { get; set; } = "add-circle";
    [Parameter] public string StepperOpenIcon { get; set; } = "remove-circle";

    // Footer
    [Parameter] public bool ShowFooter { get; set; } = true;
    [Parameter] public string BackButtonText { get; set; } = "Back";
    [Parameter] public string ContinueButtonText { get; set; } = "Continue";
    [Parameter] public string CompleteButtonText { get; set; } = "Submit";

    // Footer button icons
    /// <summary>Show the leading arrow icon on the Back button. Default: true.</summary>
    [Parameter] public bool ShowBackIcon { get; set; } = true;

    /// <summary>Show the trailing arrow icon on the Continue (non-final) button. Default: true.</summary>
    [Parameter] public bool ShowContinueIcon { get; set; } = true;

    /// <summary>Show the trailing check icon on the final Submit/Complete button. Default: true.
    /// Set false for steps like "Accept and Send" where no arrow/tick is wanted.</summary>
    [Parameter] public bool ShowCompleteIcon { get; set; } = true;

    /// <summary>Icon name for the Continue (non-final) button. Default: "arrow-forward".</summary>
    [Parameter] public string ContinueIconName { get; set; } = "arrow-forward";

    /// <summary>Icon name for the final Submit/Complete button. Default: "check".</summary>
    [Parameter] public string CompleteIconName { get; set; } = "check";

    /// <summary>
    /// Resolves the forward button's icon, honouring per-step overrides then the wizard-level
    /// show flags. Returns null when no icon should be rendered.
    /// </summary>
    private string? CurrentForwardIcon
    {
        get
        {
            // A step can opt out of its forward icon (e.g. an "Accept and Send" step).
            if (CurrentStep?.HideNextIcon == true) return null;
            // A step can override the icon name outright.
            if (!string.IsNullOrEmpty(CurrentStep?.NextIconName)) return CurrentStep!.NextIconName;

            if (IsLastStep)
                return ShowCompleteIcon ? CompleteIconName : null;
            return ShowContinueIcon ? ContinueIconName : null;
        }
    }

    /// <summary>Back button leading icon, or null to render no icon (keeps the button padding clean).</summary>
    private RenderFragment? BackIconFragment => ShowBackIcon
        ? builder =>
        {
            builder.OpenComponent<GupIcon>(0);
            builder.AddComponentParameter(1, nameof(GupIcon.IconName), "arrow-back");
            builder.AddComponentParameter(2, nameof(GupIcon.Width), 24);
            builder.AddComponentParameter(3, nameof(GupIcon.Height), 24);
            builder.CloseComponent();
        }
        : null;

    /// <summary>Forward (Continue/Submit) button trailing icon, or null to render no icon.</summary>
    private RenderFragment? ForwardIconFragment => CurrentForwardIcon is { } icon
        ? builder =>
        {
            builder.OpenComponent<GupIcon>(0);
            builder.AddComponentParameter(1, nameof(GupIcon.IconName), icon);
            builder.AddComponentParameter(2, nameof(GupIcon.Width), 24);
            builder.AddComponentParameter(3, nameof(GupIcon.Height), 24);
            builder.CloseComponent();
        }
        : null;

    /// <summary>When true, all footer buttons are disabled (e.g. while an async operation is in flight). Reset to false to re-enable navigation.</summary>
    [Parameter] public bool IsLoading { get; set; } = false;

    private string CurrentBackButtonText
        => !string.IsNullOrEmpty(CurrentStep?.BackButtonText) ? CurrentStep!.BackButtonText! : BackButtonText;

    private string CurrentNextButtonText
        => !string.IsNullOrEmpty(CurrentStep?.NextButtonText)
            ? CurrentStep!.NextButtonText!
            : (IsLastStep ? CompleteButtonText : ContinueButtonText);

    // Navigation state
    [Parameter] public int CurrentStepIndex { get; set; } = 0;
    [Parameter] public EventCallback<int> CurrentStepIndexChanged { get; set; }

    // Events
    [Parameter] public EventCallback<int> OnStepChanged { get; set; }
    [Parameter] public EventCallback<GupWizardNavArgs> OnNext { get; set; }
    [Parameter] public EventCallback<GupWizardNavArgs> OnBack { get; set; }
    [Parameter] public EventCallback<int> OnComplete { get; set; }

    [Parameter] public bool IsRTL { get; set; } = false;
    public IReadOnlyList<GUPWizardStackStep> Steps => _steps;
    public int StepCount => _steps.Count;
    public bool IsFirstStep => CurrentStepIndex <= 0;
    public bool IsLastStep => _steps.Count == 0 || CurrentStepIndex >= _steps.Count - 1;
    public GUPWizardStackStep? CurrentStep => _steps.Count > 0
        ? _steps[Math.Clamp(CurrentStepIndex, 0, _steps.Count - 1)]
        : null;

    /// <summary>True when the current step is not locked and a next step exists.</summary>
    public bool CanGoNext => CurrentStep?.Locked != true && (!IsLastStep || OnComplete.HasDelegate);

    /// <summary>True when there is a previous step to move back to.</summary>
    public bool CanGoBack => !IsFirstStep;

    private RenderFragment? CurrentStepperLabel
    {
        get
        {
            if (_steps.Count == 0) return null;
            var label = string.Format(StepLabelFormat, CurrentStepIndex + 1, _steps.Count);
            return builder => builder.AddContent(0, label);
        }
    }

    internal void RegisterStep(GUPWizardStackStep step)
    {
        if (!_steps.Contains(step))
        {
            _steps.Add(step);
            StateHasChanged();
        }
    }

    internal void UnregisterStep(GUPWizardStackStep step)
    {
        if (_steps.Remove(step))
        {
            StateHasChanged();
        }
    }

    internal void NotifyStepChanged() => StateHasChanged();

    internal bool IsStepActive(GUPWizardStackStep step)
        => CurrentStep == step;

    private string GetStepType(int index)
    {
        if (index < CurrentStepIndex) return "done";
        if (index == CurrentStepIndex) return "selected";
        return "default";
    }

    public async Task GoToStepAsync(int index)
    {
        if (index < 0 || index >= _steps.Count || index == CurrentStepIndex) return;
        CurrentStepIndex = index;
        await CurrentStepIndexChanged.InvokeAsync(CurrentStepIndex);
        await OnStepChanged.InvokeAsync(CurrentStepIndex);
        StateHasChanged();
    }

    public async Task NextAsync()
    {
        if (_steps.Count == 0) return;
        if (CurrentStep?.Locked == true) return;

        if (IsLastStep)
        {
            if (CurrentStep is { } last)
            {
                var lastArgs = new GupWizardNavArgs(CurrentStepIndex, CurrentStepIndex);
                await last.OnNext.InvokeAsync(lastArgs);
                if (lastArgs.Cancel) return;
            }
            await OnComplete.InvokeAsync(CurrentStepIndex);
            return;
        }

        var args = new GupWizardNavArgs(CurrentStepIndex, CurrentStepIndex + 1);
        if (CurrentStep is { } step)
        {
            await step.OnNext.InvokeAsync(args);
            if (args.Cancel) return;
        }
        await OnNext.InvokeAsync(args);
        if (args.Cancel) return;

        CurrentStepIndex = args.TargetStepIndex;
        await CurrentStepIndexChanged.InvokeAsync(CurrentStepIndex);
        await OnStepChanged.InvokeAsync(CurrentStepIndex);
        StateHasChanged();
    }

    public async Task BackAsync()
    {
        if (IsFirstStep) return;

        var args = new GupWizardNavArgs(CurrentStepIndex, CurrentStepIndex - 1);
        await OnBack.InvokeAsync(args);
        if (args.Cancel) return;

        CurrentStepIndex = args.TargetStepIndex;
        await CurrentStepIndexChanged.InvokeAsync(CurrentStepIndex);
        await OnStepChanged.InvokeAsync(CurrentStepIndex);
        StateHasChanged();
    }

    private string GetDirection() => IsRTL ? "rtl" : "ltr";

    private Task HandleBackAsync(MouseEventArgs _) => BackAsync();
    private Task HandleContinueAsync(MouseEventArgs _) => NextAsync();
}
