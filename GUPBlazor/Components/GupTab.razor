@* Equivalent of <gup-tab disabled selected>
   A single tab button. When nested inside a GupTabs, the parent's SelectedIndex
   drives the selected state — clicking the tab asks the parent to switch.

   Slots:
     - ChildContent  → button label
     - IconStart     → icon shown before the label
     - IconEnd       → icon shown after the label
   Events:
     - OnClick → fires when this tab is clicked (disabled tabs do not fire it)
*@
@implements IDisposable
@using Microsoft.AspNetCore.Components.Web

<button type="button"
        class="gup-tab gup-tab--appearance-@AppearanceClass @(IsFullWidth ? "gup-tab--is-full-width" : "")"
        role="tab"
        aria-selected="@(IsSelected ? "true" : "false")"
        disabled="@((Disabled && !IsSelected) ? true : null)"
        @onclick="HandleClick">
    @if (IconStart is not null)
    {
        <span class="gup-tab__icon-start">@IconStart</span>
    }
    <div class="gup-tab__content" data-title="@_labelAsText">
        @ChildContent
    </div>
    @if (IconEnd is not null)
    {
        <span class="gup-tab__icon-end">@IconEnd</span>
    }
</button>

@code {
    /// <summary>Whether the tab is disabled. Disabled tabs cannot be selected via click.</summary>
    [Parameter] public bool Disabled { get; set; }

    /// <summary>
    /// Initial selected state. When nested inside a <see cref="GupTabs"/> this only acts as a
    /// pre-selection hint — the parent owns the runtime selected state.
    /// </summary>
    [Parameter] public bool Selected { get; set; }

    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public RenderFragment? IconStart { get; set; }
    [Parameter] public RenderFragment? IconEnd { get; set; }

    /// <summary>Plain-text label, used as the bold sizing twin for the default/toggle appearances.</summary>
    [Parameter] public string? Label { get; set; }

    /// <summary>Fires when the tab is clicked (disabled tabs do not fire).</summary>
    [Parameter] public EventCallback OnClick { get; set; }

    [CascadingParameter] private GupTabs? Tabs { get; set; }

    private bool _registered;
    private string _labelAsText = string.Empty;

    private string AppearanceClass => Tabs?.AppearanceClass ?? "default";
    private bool IsFullWidth => Tabs?.IsFullWidth ?? false;
    private bool IsSelected => Tabs?.IsTabSelected(this) ?? Selected;

    protected override void OnInitialized()
    {
        if (Tabs is not null && !_registered)
        {
            Tabs.RegisterTab(this);
            _registered = true;
        }

        // Best-effort plain-text label — used by CSS to keep tab width stable when
        // the label switches to bold on selection. The Label parameter wins; otherwise
        // we leave it empty (consumers wanting the trick can pass Label="...").
        _labelAsText = Label ?? string.Empty;
    }

    internal void NotifySelectionChanged() => StateHasChanged();

    private async Task HandleClick()
    {
        if (Disabled) return;

        if (Tabs is not null)
        {
            await Tabs.NotifyTabClickedAsync(this);
        }

        if (OnClick.HasDelegate)
        {
            await OnClick.InvokeAsync();
        }
    }

    public void Dispose()
    {
        if (_registered) Tabs?.UnregisterTab(this);
    }
}
