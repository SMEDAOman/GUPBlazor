@page "/templates"

<PageTitle>Page Templates — Blazor Reference</PageTitle>

<div class="demo-page">

    <GupHeader NavAriaLabel="Demo Navigation">
        <Start>
            <GupTrack Direction="horizontal" Gap="2">
                <GupButton Appearance="@GupButtonAppearance.Text" Kind="@GupButtonKind.Link" Href="/">
                    <IconStart><GupIcon IconName="arrow-back" Width="24" Height="24" /></IconStart>
                    <ChildContent>Back to reference</ChildContent>
                </GupButton>
            </GupTrack>
        </Start>
    </GupHeader>

    <GupContentHeader PageTitle="Page Templates">
        <PageSummary>
            Whole-page compositions — the shapes a service actually ships. Each is a port of the
            matching upstream Storybook template.
        </PageSummary>
    </GupContentHeader>

    <div class="demo-body">
        <section class="demo-section">
            <div class="demo-index-grid">
                @foreach (var t in Templates)
                {
                    <a href="@t.Href" class="demo-index-card ref-card">
                        <h3>@t.Title</h3>
                        <p>@t.Description</p>
                        <span class="ref-card__route">@t.Href</span>
                    </a>
                }
            </div>
        </section>
    </div>

</div>

@code {
    private record Template(string Href, string Title, string Description);

    private static readonly Template[] Templates =
    [
        new("/service-start", "Service Start", "The wizard shell: header, content header, stepper, step content and a pinned footer with Back/Continue."),
        new("/application-completed", "Application Completed", "Confirmation page after submission — summary tables, primary and secondary actions, feedback link."),
        new("/sign-in", "Service Provider Sign In", "Sign-in screen for a service provider, with the standard page chrome."),
        new("/help", "Help Service", "Help and FAQ layout — long-form prose constrained to a readable measure."),
    ];
}
