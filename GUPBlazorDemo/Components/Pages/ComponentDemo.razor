@page "/"
@rendermode InteractiveServer

<PageTitle>Gov.om Design System — Blazor Reference</PageTitle>

<div class="demo-page">

    <GupHeader NavAriaLabel="Demo Navigation">
        <End>
            <GupTrack Direction="horizontal" HorizontalAlignment="right" Gap="2">
                <GupButton Appearance="@GupButtonAppearance.Text" Kind="@GupButtonKind.Link"
                           Href="https://storybook.service.gov.om" OpenInNewTab="true">
                    <IconStart><GupIcon IconName="open-in-new" Width="24" Height="24" /></IconStart>
                    <ChildContent><span class="gup-hide-below-mobile">Upstream Storybook</span></ChildContent>
                </GupButton>
            </GupTrack>
        </End>
    </GupHeader>

    <GupContentHeader PageTitle="Gov.om Design System — Blazor Reference">
        <PageSummary>
            Blazor implementation of the GUP web-component library — @TotalCount pages covering
            every component, form control, page template and layout foundation. All CSS and
            assets ship with the package; nothing requires npm.
        </PageSummary>
    </GupContentHeader>

    <div class="demo-body">

        <div class="ref-toolbar">
            <div class="ref-search">
                <label class="ref-search__label" for="ref-q">Find a component</label>
                <input id="ref-q" class="ref-search__input" type="search" autocomplete="off"
                       placeholder="Search components, templates and routes"
                       @bind="Query" @bind:event="oninput" />
            </div>
            @if (!string.IsNullOrWhiteSpace(Query))
            {
                <div class="ref-search__meta" role="status" aria-live="polite">
                    @MatchCount of @TotalCount
                    <button type="button" class="ref-search__clear" @onclick="@(() => Query = "")">Clear</button>
                </div>
            }
        </div>

        @foreach (var section in DemoNav.Sections)
        {
            var items = Visible(section).ToList();
            if (items.Count == 0) { continue; }

            <section class="demo-section ref-section">
                <div class="ref-section__head">
                    <h2 class="demo-section-title">@section.Title</h2>
                    <span class="ref-section__count">@items.Count</span>
                </div>
                <p class="ref-section__intro">@section.Intro</p>

                <div class="demo-index-grid">
                    @foreach (var e in items)
                    {
                        <a href="@e.Href" class="demo-index-card ref-card">
                            <h3>@e.Title</h3>
                            <p>@e.Description</p>
                            <span class="ref-card__route">@e.Href</span>
                        </a>
                    }
                </div>
            </section>
        }

        @if (MatchCount == 0)
        {
            <section class="demo-section ref-empty">
                <GupIcon IconName="search-off" Width="40" Height="40" />
                <p class="ref-empty__text">Nothing matches &ldquo;@Query&rdquo;.</p>
                <GupButton Appearance="@GupButtonAppearance.Secondary" OnClick="@(() => Query = "")">
                    <ChildContent>Clear filter</ChildContent>
                </GupButton>
            </section>
        }

    </div>

</div>

@code {
    private string Query { get; set; } = "";

    private int TotalCount => DemoNav.TotalCount;
    private int MatchCount => DemoNav.Sections.Sum(s => Visible(s).Count());

    private static IEnumerable<DemoEntry> AllOf(DemoSection s) =>
        s.Entries.Concat(s.Groups?.SelectMany(g => g.Entries) ?? []);

    private IEnumerable<DemoEntry> Visible(DemoSection s)
    {
        if (string.IsNullOrWhiteSpace(Query)) return AllOf(s);
        var q = Query.Trim();
        return AllOf(s).Where(e =>
            e.Title.Contains(q, StringComparison.OrdinalIgnoreCase) ||
            e.Description.Contains(q, StringComparison.OrdinalIgnoreCase) ||
            e.Href.Contains(q, StringComparison.OrdinalIgnoreCase) ||
            s.Title.Contains(q, StringComparison.OrdinalIgnoreCase));
    }
}
