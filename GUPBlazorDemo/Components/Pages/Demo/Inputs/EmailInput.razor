@page "/demo/inputs/email"
@rendermode InteractiveServer

<PageTitle>Email Input — Blazor Reference</PageTitle>

<div class="demo-page">


    <GupContentHeader PageTitle="Email Input">
        <PageSummary>GupInputField with <code>Type="email"</code>. Triggers email keyboards on mobile and self-validates the address format after the user interacts.</PageSummary>
    </GupContentHeader>

    <div class="demo-body">

        <section class="demo-section">
            <h2 class="demo-section-title">Basic</h2>
            <div class="demo-row">
                <div class="demo-card">
                    <DemoExample Id="default" File="EmailInput.razor" Label="Default">
                          <GupFormList>
                              <GupInputField Name="email-default" Type="email">Email address</GupInputField>
                          </GupFormList>
                    </DemoExample>
                </div>
                <div class="demo-card">
                    <DemoExample Id="with-placeholder" File="EmailInput.razor" Label="With placeholder">
                          <GupFormList>
                              <GupInputField Name="email-placeholder" Type="email" Placeholder="name@example.com">Email address</GupInputField>
                          </GupFormList>
                    </DemoExample>
                </div>
            </div>
        </section>

        <section class="demo-section">
            <h2 class="demo-section-title">States</h2>
            <div class="demo-row">
                <div class="demo-card">
                    <DemoExample Id="pre-filled" File="EmailInput.razor" Label="Pre-filled">
                          <GupFormList>
                              <GupInputField Name="email-value" Type="email" Value="ahmed@gov.om">Work email</GupInputField>
                          </GupFormList>
                    </DemoExample>
                </div>
                <div class="demo-card">
                    <DemoExample Id="read-only" File="EmailInput.razor" Label="Read-only">
                          <GupFormList>
                              <GupInputField Name="email-readonly" Type="email" Value="verified@gov.om" Readonly="true">Verified email</GupInputField>
                          </GupFormList>
                    </DemoExample>
                </div>
                <div class="demo-card">
                    <DemoExample Id="disabled" File="EmailInput.razor" Label="Disabled">
                          <GupFormList>
                              <GupInputField Name="email-disabled" Type="email" Disabled="true">Disabled email</GupInputField>
                          </GupFormList>
                    </DemoExample>
                </div>
            </div>
        </section>

        <section class="demo-section">
            <h2 class="demo-section-title">Validation</h2>
            <div class="demo-row">
                <div class="demo-card">
                    <DemoExample Id="self-validates-format" File="EmailInput.razor" Label="Self-validates format">
                          <GupFormList>
                              <GupInputField Name="email-format" Type="email" Placeholder="Try typing 'not-an-email'">
                                  <ChildContent>Email address</ChildContent>
                                  <Hint>Error appears once you blur the field with an invalid address.</Hint>
                              </GupInputField>
                          </GupFormList>
                    </DemoExample>
                </div>
                <div class="demo-card">
                    <DemoExample Id="required" File="EmailInput.razor" Label="Required">
                          <GupFormList>
                              <GupInputField Name="email-required" Type="email" Required="true">Email address</GupInputField>
                          </GupFormList>
                    </DemoExample>
                </div>
                <div class="demo-card">
                    <DemoExample Id="custom-error-message" File="EmailInput.razor" Label="Custom error message">
                          <GupFormList>
                              <GupInputField Name="email-custom-error"
                                             Type="email"
                                             Placeholder="name@example.com"
                                             ErrorMessage="@("Please use your @gov.om work email.")">
                                  Work email
                              </GupInputField>
                          </GupFormList>
                    </DemoExample>
                </div>
            </div>
        </section>

    </div>
</div>
