@page "/demo/inputs/number"

@rendermode InteractiveServer
<PageTitle>Number Input — Blazor Reference</PageTitle>

<div class="demo-page">


    <GupContentHeader PageTitle="Number Input">
        <PageSummary>GupInputField with <code>Type="number"</code>. Accepts numeric values with optional min/max/step.</PageSummary>
    </GupContentHeader>

    <div class="demo-body">

        <section class="demo-section">
            <h2 class="demo-section-title">Basic</h2>
            <div class="demo-row">
                <div class="demo-card">
                    <DemoExample Id="default" File="NumberInput.razor" Label="Default">
                          <GupFormList>
                              <GupInputField Name="num-default" Type="number">Quantity</GupInputField>
                          </GupFormList>
                    </DemoExample>
                </div>
                <div class="demo-card">
                    <DemoExample Id="with-placeholder" File="NumberInput.razor" Label="With placeholder">
                          <GupFormList>
                              <GupInputField Name="num-placeholder" Type="number" Placeholder="0">Dependants</GupInputField>
                          </GupFormList>
                    </DemoExample>
                </div>
            </div>
        </section>

        <section class="demo-section">
            <h2 class="demo-section-title">Pre-filled values</h2>
            <div class="demo-row">
                <div class="demo-card">
                    <DemoExample Id="integer" File="NumberInput.razor" Label="Integer">
                          <GupFormList>
                              <GupInputField Name="num-integer" Type="number" Value="42">Age</GupInputField>
                          </GupFormList>
                    </DemoExample>
                </div>
                <div class="demo-card">
                    <DemoExample Id="decimal" File="NumberInput.razor" Label="Decimal">
                          <GupFormList>
                              <GupInputField Name="num-decimal" Type="number" Value="1250.75">Fee amount (OMR)</GupInputField>
                          </GupFormList>
                    </DemoExample>
                </div>
            </div>
        </section>

        <section class="demo-section">
            <h2 class="demo-section-title">States</h2>
            <div class="demo-row">
                <div class="demo-card">
                    <DemoExample Id="read-only" File="NumberInput.razor" Label="Read-only">
                          <GupFormList>
                              <GupInputField Name="num-readonly" Type="number" Value="100" Readonly="true">Calculated amount</GupInputField>
                          </GupFormList>
                    </DemoExample>
                </div>
                <div class="demo-card">
                    <DemoExample Id="disabled" File="NumberInput.razor" Label="Disabled">
                          <GupFormList>
                              <GupInputField Name="num-disabled" Type="number" Disabled="true">Unavailable</GupInputField>
                          </GupFormList>
                    </DemoExample>
                </div>
            </div>
        </section>

    </div>
</div>
