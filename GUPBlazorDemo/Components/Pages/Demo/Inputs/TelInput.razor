@page "/demo/inputs/tel"
@rendermode InteractiveServer

<PageTitle>Phone Input — Blazor Reference</PageTitle>

<div class="demo-page">


    <GupContentHeader PageTitle="Phone / Tel Input">
        <PageSummary>GupInputField with <code>Type="tel"</code>. Triggers the numeric keypad on mobile and can be locked to digits-only with <code>StrictNumeric</code>.</PageSummary>
    </GupContentHeader>

    <div class="demo-body">

        <section class="demo-section">
            <h2 class="demo-section-title">Basic</h2>
            <div class="demo-row">
                <div class="demo-card">
                    <DemoExample Id="default" File="TelInput.razor" Label="Default">
                          <GupFormList>
                              <GupInputField Name="tel-default" Type="tel">Mobile number</GupInputField>
                          </GupFormList>
                    </DemoExample>
                </div>
                <div class="demo-card">
                    <DemoExample Id="with-placeholder" File="TelInput.razor" Label="With placeholder">
                          <GupFormList>
                              <GupInputField Name="tel-placeholder" Type="tel" Placeholder="+968 9XXX XXXX">Mobile number</GupInputField>
                          </GupFormList>
                    </DemoExample>
                </div>
            </div>
        </section>

        <section class="demo-section">
            <h2 class="demo-section-title">States</h2>
            <div class="demo-row">
                <div class="demo-card">
                    <DemoExample Id="pre-filled" File="TelInput.razor" Label="Pre-filled">
                          <GupFormList>
                              <GupInputField Name="tel-value" Type="tel" Value="+96899123456">Primary phone</GupInputField>
                          </GupFormList>
                    </DemoExample>
                </div>
                <div class="demo-card">
                    <DemoExample Id="read-only" File="TelInput.razor" Label="Read-only">
                          <GupFormList>
                              <GupInputField Name="tel-readonly" Type="tel" Value="+96899123456" Readonly="true">Verified number</GupInputField>
                          </GupFormList>
                    </DemoExample>
                </div>
                <div class="demo-card">
                    <DemoExample Id="disabled" File="TelInput.razor" Label="Disabled">
                          <GupFormList>
                              <GupInputField Name="tel-disabled" Type="tel" Disabled="true">Disabled phone</GupInputField>
                          </GupFormList>
                    </DemoExample>
                </div>
            </div>
        </section>

        <section class="demo-section">
            <h2 class="demo-section-title">Validation</h2>
            <div class="demo-row">
                <div class="demo-card">
                    <DemoExample Id="oman-mobile-8-digits-digits-only" File="TelInput.razor" Label="Oman mobile (8 digits, digits-only)">
                          <GupFormList>
                              <GupInputField Name="tel-oman"
                                             Type="tel"
                                             StrictNumeric="true"
                                             Pattern="\d{8,8}"
                                             MaxLength="8"
                                             Placeholder="9XXXXXXX">
                                  <ChildContent>Mobile number</ChildContent>
                                  <Hint>Try typing letters or symbols — only digits will go through.</Hint>
                              </GupInputField>
                          </GupFormList>
                    </DemoExample>
                </div>
                <div class="demo-card">
                    <DemoExample Id="required" File="TelInput.razor" Label="Required">
                          <GupFormList>
                              <GupInputField Name="tel-required"
                                             Type="tel"
                                             StrictNumeric="true"
                                             Pattern="\d{8,8}"
                                             MaxLength="8"
                                             Required="true"
                                             Placeholder="9XXXXXXX">
                                  Mobile number
                              </GupInputField>
                          </GupFormList>
                    </DemoExample>
                </div>
                <div class="demo-card">
                    <DemoExample Id="custom-error-message" File="TelInput.razor" Label="Custom error message">
                          <GupFormList>
                              <GupInputField Name="tel-custom-error"
                                             Type="tel"
                                             StrictNumeric="true"
                                             Pattern="\d{8,8}"
                                             MaxLength="8"
                                             ErrorMessage="Please enter an 8-digit Oman mobile number."
                                             Placeholder="9XXXXXXX">
                                  Mobile number
                              </GupInputField>
                          </GupFormList>
                    </DemoExample>
                </div>
            </div>
        </section>

    </div>
</div>
