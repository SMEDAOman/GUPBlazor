@page "/demo/spinner"

@rendermode InteractiveServer
<PageTitle>Spinner — Blazor Reference</PageTitle>

<div class="demo-page">


  <GupContentHeader PageTitle="Spinner (GupSpinner)">
    <PageSummary>Accessible loading indicator using the gov.om brand spinner SVG.</PageSummary>
  </GupContentHeader>

  <div class="demo-body">

    <!-- ══ SIZES ══ -->
    <section class="demo-section">
      <h2 class="demo-section-title">Sizes</h2>

      <div class="demo-row">
        <div class="demo-card">
          <DemoExample Id="small-16px" File="Spinner.razor" Label="Small (16px)" style="display:flex; justify-content:center;">
              <GupSpinner Size="small" />
          </DemoExample>
        </div>
        <div class="demo-card">
          <DemoExample Id="medium-default-24px" File="Spinner.razor" Label="Medium · default (24px)" style="display:flex; justify-content:center;">
              <GupSpinner />
          </DemoExample>
        </div>
        <div class="demo-card">
          <DemoExample Id="large-40px" File="Spinner.razor" Label="Large (40px)" style="display:flex; justify-content:center;">
              <GupSpinner Size="large" />
          </DemoExample>
        </div>
        <div class="demo-card">
          <span class="demo-card-label">Custom · Pixels="56"</span>
          <div class="demo-surface" style="display:flex; justify-content:center;">
            <GupSpinner Pixels="56" />
          </div>
        </div>
      </div>
    </section>

    <!-- ══ WITH TEXT ══ -->
    <section class="demo-section">
      <h2 class="demo-section-title">With visible text</h2>

      <div class="demo-row">
        <div class="demo-card demo-card--full">
          <DemoExample Id="inline-text-label" File="Spinner.razor" Label="Inline text label">
              <GupSpinner Text="Loading..." />
          </DemoExample>
        </div>
        <div class="demo-card demo-card--full">
          <DemoExample Id="large-with-text-custom-aria-label" File="Spinner.razor" Label="Large with text · custom ARIA label">
              <GupSpinner Size="large"
                          Text="Submitting your application..."
                          Label="Submitting your application, please wait" />
          </DemoExample>
        </div>
      </div>
    </section>

    <!-- ══ IN-CONTEXT ══ -->
    <section class="demo-section">
      <h2 class="demo-section-title">In context</h2>

      <div class="demo-row">
        <div class="demo-card">
          <DemoExample Id="inside-a-button" File="Spinner.razor" Label="Inside a button" style="display:flex; justify-content:center;">
              <GupButton Appearance="@GupButtonAppearance.Primary" Kind="@GupButtonKind.Button">
                <ChildContent>
                  <GupTrack Direction="horizontal" Gap="2" VerticalAlignment="center">
                    <GupSpinner Size="small" Label="Saving" />
                    <span>Saving…</span>
                  </GupTrack>
                </ChildContent>
              </GupButton>
          </DemoExample>
        </div>
        <div class="demo-card">
          <DemoExample Id="centered-loading-panel" File="Spinner.razor" Label="Centered loading panel" style="min-height:120px; display:flex; align-items:center; justify-content:center;">
              <GupSpinner Size="large" Text="Fetching data..." />
          </DemoExample>
        </div>
        <div class="demo-card demo-card--full">
          <span class="demo-card-label">Inside a banner</span>
          <GupBanner HideIcon="true" ShowCloseButton="false">
            <TitleContent>
              <GupTrack Direction="horizontal" Gap="2" VerticalAlignment="center">
                <GupSpinner Size="small" Label="Processing" />
                <span>Processing your request</span>
              </GupTrack>
            </TitleContent>
            <ChildContent>
              <GupRichText>
                <p>This usually takes less than 30 seconds. Please don't close this window.</p>
              </GupRichText>
            </ChildContent>
          </GupBanner>
        </div>
      </div>
    </section>

    <!-- ══ COLORED ══ -->
    <section class="demo-section">
      <h2 class="demo-section-title">On dark surface</h2>

      <div class="demo-row">
        <div class="demo-card">
          <span class="demo-card-label">On brand background</span>
          <div class="demo-surface"
               style="background: var(--gup-color-brand-medium); display:flex; justify-content:center; padding:24px;">
            <GupSpinner Size="large" />
          </div>
        </div>
        <div class="demo-card">
          <DemoExample Id="on-dark-canvas" File="Spinner.razor" Label="On dark canvas" SurfaceClass="--dark" style="display:flex; justify-content:center; padding:24px;">
              <GupSpinner Size="large" Text="Loading..." />
          </DemoExample>
        </div>
      </div>
    </section>

  </div>
</div>
